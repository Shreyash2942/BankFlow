# Day 1 template. Settings loading is implemented on Day 2.
# Fictional demo data only. Copy to .env and fill locally; never commit .env.
APP_ENV=development

# Windows-host application -> existing datalab published ports.
# Container mappings inspected; services are stopped and connectivity is unverified.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=bankflow
POSTGRES_USER=bankflow_user
POSTGRES_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0

# Confirm advertised listeners before producer/consumer integration.
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_TRANSACTION_TOPIC=bankflow.transaction.events
KAFKA_CONSUMER_GROUP=bankflow-operational-v1

MAX_PIN_ATTEMPTS=3
AUTO_CLOSE_ZERO_BALANCE=true
