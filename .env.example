# Loaded explicitly by BankFlow settings; run commands from the repository root.
# Fictional demo data only. Copy to .env and fill locally; never commit .env.
APP_ENV=development

# Windows-host application -> dedicated bankflow container published ports.
# Supply the dedicated application role password locally before running migrations.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=bankflow
POSTGRES_USER=bankflow_user
POSTGRES_PASSWORD=
POSTGRES_CONNECT_TIMEOUT=5
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10

REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SOCKET_TIMEOUT=2

# Confirm advertised listeners before producer/consumer integration.
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9093
KAFKA_TRANSACTION_TOPIC=bankflow.transaction.events
KAFKA_CONSUMER_GROUP=bankflow-operational-v1

MAX_PIN_ATTEMPTS=3
PIN_ATTEMPT_TTL_SECONDS=900
AUTH_SESSION_TTL_SECONDS=900
AUTO_CLOSE_ZERO_BALANCE=true
